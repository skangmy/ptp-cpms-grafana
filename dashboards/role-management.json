                "content": "<style>\n  #cpms-role-management,\n  #cpms-role-management * {\n    box-sizing: border-box;\n  }\n\n  #cpms-role-management {\n    --crm-bg: #f4f6f9;\n    --crm-panel: #ffffff;\n    --crm-border: #d8dee8;\n    --crm-line: #edf0f5;\n    --crm-text: #172033;\n    --crm-muted: #667085;\n    --crm-blue: #286eb7;\n    --crm-blue-soft: #edf5ff;\n    --crm-green: #2f855a;\n    --crm-green-soft: #edf9f1;\n    --crm-amber: #a66b00;\n    --crm-amber-soft: #fff8e7;\n    --crm-red: #b42318;\n    --crm-red-soft: #fff1f0;\n    width: 100%;\n    min-width: 0;\n    padding: 14px;\n    color: var(--crm-text);\n    background: var(--crm-bg);\n    font-family: var(--font-sans, Inter, Arial, sans-serif);\n  }\n\n  #cpms-role-management .crm-header,\n  #cpms-role-management .crm-header-meta,\n  #cpms-role-management .crm-card-head,\n  #cpms-role-management .crm-actions,\n  #cpms-role-management .crm-role-cell,\n  #cpms-role-management .crm-enabled-cell {\n    display: flex;\n    align-items: center;\n  }\n\n  #cpms-role-management .crm-header {\n    justify-content: space-between;\n    gap: 16px;\n    margin-bottom: 10px;\n  }\n\n  #cpms-role-management .crm-title,\n  #cpms-role-management .crm-card-title {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  #cpms-role-management .crm-subtitle,\n  #cpms-role-management .crm-card-note,\n  #cpms-role-management .crm-help,\n  #cpms-role-management .crm-empty {\n    color: var(--crm-muted);\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-header-meta {\n    justify-content: flex-end;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  #cpms-role-management .crm-chip,\n  #cpms-role-management .crm-badge {\n    display: inline-flex;\n    align-items: center;\n    white-space: nowrap;\n  }\n\n  #cpms-role-management .crm-chip {\n    min-height: 28px;\n    padding: 4px 9px;\n    border: 1px solid var(--crm-border);\n    border-radius: 999px;\n    background: var(--crm-panel);\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-chip[data-tone='bad'] {\n    color: var(--crm-red);\n    border-color: #efb8b8;\n    background: var(--crm-red-soft);\n  }\n\n  #cpms-role-management .crm-summary {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(120px, 1fr));\n    gap: 8px;\n    margin-bottom: 10px;\n  }\n\n  #cpms-role-management .crm-summary-card,\n  #cpms-role-management .crm-card {\n    border: 1px solid var(--crm-border);\n    border-radius: 7px;\n    background: var(--crm-panel);\n    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);\n  }\n\n  #cpms-role-management .crm-summary-card {\n    min-height: 66px;\n    padding: 9px 11px;\n  }\n\n  #cpms-role-management .crm-summary-label,\n  #cpms-role-management .crm-field-label,\n  #cpms-role-management .crm-table th {\n    color: var(--crm-muted);\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n  }\n\n  #cpms-role-management .crm-summary-value {\n    margin-top: 4px;\n    font-size: 18px;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n\n  #cpms-role-management .crm-layout {\n    display: grid;\n    grid-template-columns: minmax(260px, 4fr) minmax(0, 8fr);\n    gap: 10px;\n  }\n\n  #cpms-role-management .crm-card {\n    min-width: 0;\n    overflow: hidden;\n  }\n\n  #cpms-role-management .crm-card-head {\n    min-height: 48px;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 10px 13px;\n    border-bottom: 1px solid var(--crm-line);\n  }\n\n  #cpms-role-management .crm-card-body {\n    padding: 12px 13px;\n  }\n\n  #cpms-role-management .crm-card-body--flush {\n    padding: 0;\n  }\n\n  #cpms-role-management .crm-form {\n    display: grid;\n    gap: 12px;\n  }\n\n  #cpms-role-management .crm-field {\n    display: grid;\n    gap: 5px;\n  }\n\n  #cpms-role-management .crm-input,\n  #cpms-role-management .crm-select {\n    width: 100%;\n    min-height: 34px;\n    padding: 6px 9px;\n    border: 1px solid var(--crm-border);\n    border-radius: 5px;\n    color: var(--crm-text);\n    background: var(--crm-panel);\n    font-family: inherit;\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-input:focus-visible,\n  #cpms-role-management .crm-select:focus-visible,\n  #cpms-role-management .crm-button:focus-visible,\n  #cpms-role-management .crm-switch:focus-visible {\n    outline: 2px solid #75aee8;\n    outline-offset: 2px;\n  }\n\n  #cpms-role-management .crm-actions {\n    justify-content: flex-end;\n    gap: 8px;\n  }\n\n  #cpms-role-management .crm-button {\n    min-height: 32px;\n    padding: 5px 11px;\n    border: 1px solid transparent;\n    border-radius: 5px;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 600;\n    cursor: pointer;\n  }\n\n  #cpms-role-management .crm-button--primary {\n    color: #ffffff;\n    background: var(--crm-blue);\n  }\n\n  #cpms-role-management .crm-button--secondary {\n    color: var(--crm-text);\n    border-color: var(--crm-border);\n    background: var(--crm-panel);\n  }\n\n  #cpms-role-management .crm-button--danger {\n    color: var(--crm-red);\n    border-color: #efb8b8;\n    background: var(--crm-red-soft);\n  }\n\n  #cpms-role-management .crm-button:disabled,\n  #cpms-role-management .crm-input:disabled,\n  #cpms-role-management .crm-select:disabled,\n  #cpms-role-management .crm-switch:disabled {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n\n  #cpms-role-management .crm-toolbar {\n    display: grid;\n    grid-template-columns: minmax(180px, 320px) auto;\n    gap: 8px;\n  }\n\n  #cpms-role-management .crm-table-wrap {\n    overflow-x: auto;\n  }\n\n  #cpms-role-management .crm-table {\n    width: 100%;\n    min-width: 760px;\n    border-collapse: collapse;\n  }\n\n  #cpms-role-management .crm-table th,\n  #cpms-role-management .crm-table td {\n    padding: 9px 11px;\n    border-bottom: 1px solid var(--crm-line);\n    text-align: left;\n    vertical-align: middle;\n  }\n\n  #cpms-role-management .crm-table td {\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-table tbody tr:last-child td {\n    border-bottom: 0;\n  }\n\n  #cpms-role-management .crm-username {\n    font-weight: 700;\n  }\n\n  #cpms-role-management .crm-role-cell,\n  #cpms-role-management .crm-enabled-cell {\n    gap: 7px;\n  }\n\n  #cpms-role-management .crm-table .crm-select {\n    min-width: 125px;\n  }\n\n  #cpms-role-management .crm-badge {\n    min-height: 22px;\n    padding: 3px 7px;\n    border: 1px solid var(--crm-border);\n    border-radius: 999px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n  }\n\n  #cpms-role-management .crm-badge[data-tone='good'] {\n    color: var(--crm-green);\n    border-color: #b7dbc5;\n    background: var(--crm-green-soft);\n  }\n\n  #cpms-role-management .crm-badge[data-tone='warn'] {\n    color: var(--crm-amber);\n    border-color: #ead08c;\n    background: var(--crm-amber-soft);\n  }\n\n  #cpms-role-management .crm-badge[data-tone='bad'] {\n    color: var(--crm-red);\n    border-color: #efb8b8;\n    background: var(--crm-red-soft);\n  }\n\n  #cpms-role-management .crm-status {\n    min-height: 36px;\n    margin-top: 10px;\n    padding: 8px 10px;\n    border: 1px solid var(--crm-border);\n    border-radius: 5px;\n    color: var(--crm-muted);\n    background: var(--crm-panel);\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-status[data-tone='good'] {\n    color: var(--crm-green);\n    border-color: #b7dbc5;\n    background: var(--crm-green-soft);\n  }\n\n  #cpms-role-management .crm-status[data-tone='bad'] {\n    color: var(--crm-red);\n    border-color: #efb8b8;\n    background: var(--crm-red-soft);\n  }\n\n  #cpms-role-management .crm-empty {\n    padding: 24px 13px;\n    text-align: center;\n  }\n\n  @media (max-width: 900px) {\n    #cpms-role-management .crm-layout {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  @media (max-width: 620px) {\n    #cpms-role-management {\n      padding: 9px;\n    }\n\n    #cpms-role-management .crm-header {\n      align-items: flex-start;\n      flex-direction: column;\n    }\n\n    #cpms-role-management .crm-header-meta {\n      justify-content: flex-start;\n    }\n\n    #cpms-role-management .crm-summary {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    #cpms-role-management .crm-toolbar {\n      grid-template-columns: 1fr;\n    }\n  }\n  /* ---------- Dark theme (applied when Grafana is in dark mode) ---------- */\n  #cpms-role-management.crm-dark {\n    --crm-bg: #111217;\n    --crm-panel: #181b1f;\n    --crm-border: #34373d;\n    --crm-line: #2a2d33;\n    --crm-text: #e4e4ec;\n    --crm-muted: #b0b0be;\n    --crm-blue: #3d71d9;\n    --crm-blue-soft: rgba(87, 148, 242, 0.16);\n    --crm-green: #73bf69;\n    --crm-green-soft: rgba(115, 191, 105, 0.16);\n    --crm-amber: #f2cc0c;\n    --crm-amber-soft: rgba(242, 204, 12, 0.14);\n    --crm-red: #ff7383;\n    --crm-red-soft: rgba(242, 73, 92, 0.16);\n    color-scheme: dark;\n  }\n  #cpms-role-management.crm-dark .crm-chip[data-tone='bad'],\n  #cpms-role-management.crm-dark .crm-button--danger,\n  #cpms-role-management.crm-dark .crm-badge[data-tone='bad'],\n  #cpms-role-management.crm-dark .crm-status[data-tone='bad'] { border-color: rgba(242, 73, 92, 0.45); }\n  #cpms-role-management.crm-dark .crm-badge[data-tone='good'],\n  #cpms-role-management.crm-dark .crm-status[data-tone='good'] { border-color: rgba(115, 191, 105, 0.45); }\n  #cpms-role-management.crm-dark .crm-badge[data-tone='warn'] { border-color: rgba(242, 204, 12, 0.45); }\n  #cpms-role-management.crm-dark .crm-select option { color: #e4e4ec; background: #181b1f; }\n</style>\n\n<section id=\"cpms-role-management\" aria-labelledby=\"crm-title\">\n  <header class=\"crm-header\">\n    <div>\n      <h1 id=\"crm-title\" class=\"crm-title\">CPMS Role Management</h1>\n      <div class=\"crm-subtitle\">Assign application permissions to authenticated Grafana users</div>\n    </div>\n    <div class=\"crm-header-meta\">\n      <span id=\"crm-connection\" class=\"crm-chip\" role=\"status\" aria-live=\"polite\">Loading</span>\n      <span id=\"crm-operator\" class=\"crm-chip\">Administrator: —</span>\n    </div>\n  </header>\n\n  <section class=\"crm-summary\" aria-label=\"Role assignment summary\">\n    <div class=\"crm-summary-card\"><div class=\"crm-summary-label\">Assignments</div><div id=\"crm-total\" class=\"crm-summary-value\">—</div></div>\n    <div class=\"crm-summary-card\"><div class=\"crm-summary-label\">Enabled</div><div id=\"crm-enabled\" class=\"crm-summary-value\">—</div></div>\n    <div class=\"crm-summary-card\"><div class=\"crm-summary-label\">Administrators</div><div id=\"crm-admins\" class=\"crm-summary-value\">—</div></div>\n    <div class=\"crm-summary-card\"><div class=\"crm-summary-label\">Disabled</div><div id=\"crm-disabled\" class=\"crm-summary-value\">—</div></div>\n  </section>\n\n  <div class=\"crm-layout\">\n    <section class=\"crm-card\" aria-labelledby=\"crm-add-title\">\n      <div class=\"crm-card-head\">\n        <div>\n          <h2 id=\"crm-add-title\" class=\"crm-card-title\">Add Assignment</h2>\n          <div class=\"crm-card-note\">Username must match the Grafana login</div>\n        </div>\n      </div>\n      <div class=\"crm-card-body\">\n        <form id=\"crm-add-form\" class=\"crm-form\">\n          <label class=\"crm-field\">\n            <span class=\"crm-field-label\">Username</span>\n            <input id=\"crm-new-username\" class=\"crm-input\" name=\"username\" type=\"text\" maxlength=\"255\" autocomplete=\"off\" required>\n          </label>\n          <label class=\"crm-field\">\n            <span class=\"crm-field-label\">CPMS Role</span>\n            <select id=\"crm-new-role\" class=\"crm-select\" name=\"role\">\n              <option value=\"OBSERVER\">Observer</option>\n              <option value=\"OPERATOR\">Operator</option>\n              <option value=\"SUPERVISOR\">Supervisor</option>\n              <option value=\"ADMIN\">Administrator</option>\n            </select>\n          </label>\n          <label class=\"crm-enabled-cell\">\n            <input id=\"crm-new-enabled\" class=\"crm-switch\" name=\"enabled\" type=\"checkbox\" checked>\n            <span class=\"crm-help\">Enable this assignment immediately</span>\n          </label>\n          <div class=\"crm-help\">Users without an enabled assignment receive the default OBSERVER role.</div>\n          <div class=\"crm-actions\">\n            <button id=\"crm-add-button\" class=\"crm-button crm-button--primary\" type=\"submit\">Add Assignment</button>\n          </div>\n        </form>\n      </div>\n    </section>\n\n    <section class=\"crm-card\" aria-labelledby=\"crm-list-title\">\n      <div class=\"crm-card-head\">\n        <div>\n          <h2 id=\"crm-list-title\" class=\"crm-card-title\">User Assignments</h2>\n          <div class=\"crm-card-note\">Changes take effect on the user’s next authorized request</div>\n        </div>\n        <div class=\"crm-toolbar\">\n          <input id=\"crm-search\" class=\"crm-input\" type=\"search\" placeholder=\"Search username\" aria-label=\"Search role assignments\">\n          <button id=\"crm-refresh\" class=\"crm-button crm-button--secondary\" type=\"button\">Refresh</button>\n        </div>\n      </div>\n      <div class=\"crm-card-body crm-card-body--flush crm-table-wrap\">\n        <table class=\"crm-table\">\n          <thead><tr><th>User</th><th>Role</th><th>Enabled</th><th>Updated</th><th>Updated By</th><th>Action</th></tr></thead>\n          <tbody id=\"crm-rows\"><tr><td colspan=\"6\"><div class=\"crm-empty\">Loading role assignments…</div></td></tr></tbody>\n        </table>\n      </div>\n    </section>\n  </div>\n\n  <div id=\"crm-status\" class=\"crm-status\" role=\"status\" aria-live=\"polite\">Loading administrator identity and assignments…</div>\n</section>\n\n<script>\n  (() => {\n    const root = document.getElementById('cpms-role-management');\n    if (!root) return;\n    if (typeof root.__crmCleanup === 'function') root.__crmCleanup();\n\n    // Theme: follow the viewer's Grafana theme (adds 'crm-dark' in dark mode).\n    // Re-checked whenever Grafana switches theme, since this panel isn't re-rendered.\n    // Wrapped in try/catch so a theme problem can never stop the role management script below.\n    try {\n        if (typeof root.__crmThemeStop === 'function') root.__crmThemeStop();\n        const isDarkColor = (el) => {\n            const v = (getComputedStyle(el).backgroundColor.match(/[\\d.]+/g) || []).map(Number);\n            if (v.length < 3 || (v.length >= 4 && v[3] === 0)) return null; // transparent / unknown\n            return (0.299 * v[0] + 0.587 * v[1] + 0.114 * v[2]) < 128;\n        };\n        const detect = () => {\n            const fromColor = isDarkColor(document.body) ?? isDarkColor(document.documentElement);\n            if (fromColor !== null) return fromColor;\n            if (document.body.classList.contains('theme-light')) return false;\n            if (document.body.classList.contains('theme-dark')) return true;\n            return window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;\n        };\n        const apply = () => {\n            try {\n                if (!document.contains(root)) return stopTheme();\n                root.classList.toggle('crm-dark', detect());\n            } catch (e) { /* keep current theme */ }\n        };\n        const themeObserver = new MutationObserver(apply);\n        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style', 'data-theme'] });\n        themeObserver.observe(document.body, { attributes: true, attributeFilter: ['class', 'style'] });\n        themeObserver.observe(document.head, { childList: true, subtree: true, characterData: true });\n        const themeTimer = setInterval(apply, 2000); // safety net\n        function stopTheme() { themeObserver.disconnect(); clearInterval(themeTimer); }\n        root.__crmThemeStop = stopTheme;\n        apply();\n    } catch (e) {\n        console.warn('CPMS Role Management: theme detection unavailable', e);\n    }\n\n    const API = '/cpms/auth';\n    const REQUEST_TIMEOUT_MS = 10000;\n    const roles = ['OBSERVER', 'OPERATOR', 'SUPERVISOR', 'ADMIN'];\n    const state = { identity: null, users: [], busy: false, connectionError: false };\n    const controllers = new Set();\n    const $ = (selector) => root.querySelector(selector);\n\n    function setText(selector, value) {\n      const target = $(selector);\n      if (target) target.textContent = value;\n    }\n\n    function setStatus(message, tone) {\n      const target = $('#crm-status');\n      target.textContent = message;\n      target.dataset.tone = tone || '';\n    }\n\n    async function request(path, options) {\n      const controller = new AbortController();\n      const timeout = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);\n      controllers.add(controller);\n      try {\n        const response = await fetch(API + path, {\n          credentials: 'same-origin',\n          ...options,\n          headers: { 'Content-Type': 'application/json', ...(options && options.headers) },\n          signal: controller.signal,\n        });\n        const contentType = response.headers.get('content-type') || '';\n        const body = contentType.includes('application/json') ? await response.json() : null;\n        if (!response.ok) {\n          if ([502, 503, 504].includes(response.status)) {\n            throw new Error(`CPMS API server is unavailable (HTTP ${response.status}). Check that the service is running and the /cpms proxy is configured.`);\n          }\n          throw new Error((body && body.error) || `Request failed (${response.status})`);\n        }\n        return body;\n      } finally {\n        clearTimeout(timeout);\n        controllers.delete(controller);\n      }\n    }\n\n    function isConnectionError(error) {\n      const message = error instanceof Error ? error.message : String(error || '');\n      return Boolean(error && error.name === 'AbortError') ||\n        error instanceof TypeError ||\n        /failed to fetch|networkerror|api server is unavailable/i.test(message);\n    }\n\n    function errorMessage(error) {\n      if (error && error.name === 'AbortError') {\n        return 'The CPMS API server did not respond within 10 seconds. Check that the service is running and reachable.';\n      }\n      if (error instanceof TypeError || /failed to fetch|networkerror/i.test(error && error.message || '')) {\n        return 'Cannot connect to the CPMS API server. Check that the service is running and the /cpms proxy is available.';\n      }\n      return error instanceof Error ? error.message : 'An unexpected API error occurred.';\n    }\n\n    function formatTime(value) {\n      const date = new Date(value);\n      if (!value || Number.isNaN(date.getTime())) return '—';\n      return new Intl.DateTimeFormat('en-GB', {\n        timeZone: 'Asia/Kuala_Lumpur',\n        day: '2-digit',\n        month: '2-digit',\n        year: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit',\n        hour12: false,\n      }).format(date);\n    }\n\n    function cell(text, className) {\n      const target = document.createElement('td');\n      target.textContent = text;\n      if (className) target.className = className;\n      return target;\n    }\n\n    function badge(text, tone) {\n      const target = document.createElement('span');\n      target.className = 'crm-badge';\n      target.dataset.tone = tone;\n      target.textContent = text;\n      return target;\n    }\n\n    function roleSelect(value) {\n      const select = document.createElement('select');\n      select.className = 'crm-select';\n      select.setAttribute('aria-label', 'CPMS role');\n      roles.forEach((role) => {\n        const option = document.createElement('option');\n        option.value = role;\n        option.textContent = role === 'ADMIN' ? 'Administrator' : role.charAt(0) + role.slice(1).toLowerCase();\n        option.selected = role === value;\n        select.appendChild(option);\n      });\n      return select;\n    }\n\n    function renderSummary() {\n      const enabled = state.users.filter((user) => user.enabled).length;\n      setText('#crm-total', String(state.users.length));\n      setText('#crm-enabled', String(enabled));\n      setText('#crm-admins', String(state.users.filter((user) => user.enabled && user.role === 'ADMIN').length));\n      setText('#crm-disabled', String(state.users.length - enabled));\n    }\n\n    function renderRows() {\n      const body = $('#crm-rows');\n      const filter = $('#crm-search').value.trim().toLowerCase();\n      const users = state.users.filter((user) => user.username.toLowerCase().includes(filter));\n      body.replaceChildren();\n\n      if (!users.length) {\n        const row = document.createElement('tr');\n        const target = cell(filter ? 'No matching assignments.' : 'No role assignments configured.');\n        target.colSpan = 6;\n        target.className = 'crm-empty';\n        row.appendChild(target);\n        body.appendChild(row);\n        return;\n      }\n\n      users.forEach((user) => {\n        const row = document.createElement('tr');\n        const username = cell(user.username, 'crm-username');\n        const roleCell = document.createElement('td');\n        const select = roleSelect(user.role);\n        select.disabled = state.busy;\n        roleCell.appendChild(select);\n\n        const enabledCell = document.createElement('td');\n        enabledCell.className = 'crm-enabled-cell';\n        const enabled = document.createElement('input');\n        enabled.className = 'crm-switch';\n        enabled.type = 'checkbox';\n        enabled.checked = Boolean(user.enabled);\n        enabled.disabled = state.busy;\n        enabled.setAttribute('aria-label', `Enable ${user.username}`);\n        const enabledBadge = badge(user.enabled ? 'Enabled' : 'Disabled', user.enabled ? 'good' : 'bad');\n        enabledCell.append(enabled, enabledBadge);\n\n        const actionCell = document.createElement('td');\n        actionCell.className = 'crm-actions';\n        const save = document.createElement('button');\n        save.className = 'crm-button crm-button--primary';\n        save.type = 'button';\n        save.textContent = 'Save';\n        save.disabled = true;\n        const remove = document.createElement('button');\n        remove.className = 'crm-button crm-button--danger';\n        remove.type = 'button';\n        remove.textContent = 'Delete';\n        remove.disabled = state.busy || Boolean(state.identity && state.identity.username.toLowerCase() === user.username.toLowerCase());\n        if (remove.disabled && !state.busy) remove.title = 'You cannot delete your own administrator assignment';\n        actionCell.append(save, remove);\n\n        const refreshDirty = () => {\n          const dirty = select.value !== user.role || enabled.checked !== Boolean(user.enabled);\n          enabledBadge.textContent = enabled.checked ? 'Enabled' : 'Disabled';\n          enabledBadge.dataset.tone = enabled.checked ? 'good' : 'bad';\n          save.disabled = !dirty || state.busy;\n        };\n        select.addEventListener('change', refreshDirty);\n        enabled.addEventListener('change', refreshDirty);\n        save.addEventListener('click', () => saveUser(user, select.value, enabled.checked));\n        remove.addEventListener('click', () => deleteUser(user));\n\n        row.append(username, roleCell, enabledCell, cell(formatTime(user.updatedAt)), cell(user.updatedBy || '—'), actionCell);\n        body.appendChild(row);\n      });\n    }\n\n    function render() {\n      renderSummary();\n      renderRows();\n      setText('#crm-operator', `Administrator: ${state.identity ? state.identity.username : '—'}`);\n      const connection = $('#crm-connection');\n      connection.textContent = state.connectionError ? 'API Offline' : state.identity ? 'Connected' : 'Unavailable';\n      connection.dataset.tone = state.connectionError ? 'bad' : '';\n      const disabled = state.busy || !state.identity;\n      $('#crm-add-button').disabled = disabled;\n      $('#crm-refresh').disabled = state.busy;\n    }\n\n    async function load() {\n      if (state.busy) return;\n      state.busy = true;\n      render();\n      setStatus('Loading role assignments…');\n      try {\n        const [identity, result] = await Promise.all([request('/me'), request('/roles')]);\n        state.identity = identity;\n        state.users = Array.isArray(result.users) ? result.users : [];\n        state.connectionError = false;\n        setStatus(`Loaded ${state.users.length} role assignments.`, 'good');\n      } catch (error) {\n        state.identity = null;\n        state.users = [];\n        state.connectionError = isConnectionError(error);\n        setStatus(errorMessage(error), 'bad');\n      } finally {\n        state.busy = false;\n        render();\n      }\n    }\n\n    async function saveAssignment(payload, successMessage) {\n      if (state.busy) return;\n      state.busy = true;\n      render();\n      setStatus(`Saving ${payload.username}…`);\n      try {\n        const result = await request('/roles/save', { method: 'POST', body: JSON.stringify(payload) });\n        const index = state.users.findIndex((user) => user.username.toLowerCase() === result.user.username.toLowerCase());\n        if (index >= 0) state.users[index] = result.user;\n        else state.users.push(result.user);\n        state.connectionError = false;\n        setStatus(successMessage, 'good');\n        return true;\n      } catch (error) {\n        state.connectionError = isConnectionError(error);\n        setStatus(errorMessage(error), 'bad');\n        return false;\n      } finally {\n        state.busy = false;\n        render();\n      }\n    }\n\n    async function saveUser(user, role, enabled) {\n      const sensitive = (user.role === 'ADMIN' && role !== 'ADMIN') || (user.enabled && !enabled);\n      if (sensitive && !confirm(`Confirm the role or enabled-state change for ${user.username}?`)) return;\n      await saveAssignment({ username: user.username, role, enabled }, `Updated ${user.username}.`);\n    }\n\n    async function deleteUser(user) {\n      if (!confirm(`Delete the CPMS role assignment for ${user.username}? The user will revert to OBSERVER access.`)) return;\n      if (state.busy) return;\n      state.busy = true;\n      render();\n      setStatus(`Deleting ${user.username}…`);\n      try {\n        await request('/roles/delete', { method: 'POST', body: JSON.stringify({ username: user.username }) });\n        state.users = state.users.filter((item) => item.username.toLowerCase() !== user.username.toLowerCase());\n        state.connectionError = false;\n        setStatus(`Deleted ${user.username}. The user now has default OBSERVER access.`, 'good');\n      } catch (error) {\n        state.connectionError = isConnectionError(error);\n        setStatus(errorMessage(error), 'bad');\n      } finally {\n        state.busy = false;\n        render();\n      }\n    }\n\n    $('#crm-add-form').addEventListener('submit', async (event) => {\n      event.preventDefault();\n      const username = $('#crm-new-username').value.trim();\n      if (!username) return setStatus('Username is required.', 'bad');\n      const saved = await saveAssignment(\n        { username, role: $('#crm-new-role').value, enabled: $('#crm-new-enabled').checked },\n        `Added ${username}.`\n      );\n      if (saved) {\n        $('#crm-add-form').reset();\n        $('#crm-new-enabled').checked = true;\n      }\n    });\n    $('#crm-search').addEventListener('input', renderRows);\n    $('#crm-refresh').addEventListener('click', load);\n\n    const observer = new MutationObserver(() => {\n      if (!root.isConnected) root.__crmCleanup();\n    });\n    if (root.parentNode) observer.observe(root.parentNode, { childList: true });\n    root.__crmCleanup = () => {\n      observer.disconnect();\n      controllers.forEach((controller) => controller.abort());\n      controllers.clear();\n      root.__crmCleanup = null;\n    };\n\n    load();\n  })();\n</script>\n",
