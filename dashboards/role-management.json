                "content": "\u003cstyle\u003e\n  #cpms-role-management,\n  #cpms-role-management * {\n    box-sizing: border-box;\n  }\n\n  #cpms-role-management {\n    --crm-bg: #f4f6f9;\n    --crm-panel: #ffffff;\n    --crm-border: #d8dee8;\n    --crm-line: #edf0f5;\n    --crm-text: #172033;\n    --crm-muted: #667085;\n    --crm-blue: #286eb7;\n    --crm-blue-soft: #edf5ff;\n    --crm-green: #2f855a;\n    --crm-green-soft: #edf9f1;\n    --crm-amber: #a66b00;\n    --crm-amber-soft: #fff8e7;\n    --crm-red: #b42318;\n    --crm-red-soft: #fff1f0;\n    width: 100%;\n    min-width: 0;\n    padding: 14px;\n    color: var(--crm-text);\n    background: var(--crm-bg);\n    font-family: var(--font-sans, Inter, Arial, sans-serif);\n  }\n\n  #cpms-role-management .crm-header,\n  #cpms-role-management .crm-header-meta,\n  #cpms-role-management .crm-card-head,\n  #cpms-role-management .crm-actions,\n  #cpms-role-management .crm-role-cell,\n  #cpms-role-management .crm-enabled-cell {\n    display: flex;\n    align-items: center;\n  }\n\n  #cpms-role-management .crm-header {\n    justify-content: space-between;\n    gap: 16px;\n    margin-bottom: 10px;\n  }\n\n  #cpms-role-management .crm-title,\n  #cpms-role-management .crm-card-title {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  #cpms-role-management .crm-subtitle,\n  #cpms-role-management .crm-card-note,\n  #cpms-role-management .crm-help,\n  #cpms-role-management .crm-empty {\n    color: var(--crm-muted);\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-header-meta {\n    justify-content: flex-end;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  #cpms-role-management .crm-chip,\n  #cpms-role-management .crm-badge {\n    display: inline-flex;\n    align-items: center;\n    white-space: nowrap;\n  }\n\n  #cpms-role-management .crm-chip {\n    min-height: 28px;\n    padding: 4px 9px;\n    border: 1px solid var(--crm-border);\n    border-radius: 999px;\n    background: var(--crm-panel);\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-summary {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(120px, 1fr));\n    gap: 8px;\n    margin-bottom: 10px;\n  }\n\n  #cpms-role-management .crm-summary-card,\n  #cpms-role-management .crm-card {\n    border: 1px solid var(--crm-border);\n    border-radius: 7px;\n    background: var(--crm-panel);\n    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);\n  }\n\n  #cpms-role-management .crm-summary-card {\n    min-height: 66px;\n    padding: 9px 11px;\n  }\n\n  #cpms-role-management .crm-summary-label,\n  #cpms-role-management .crm-field-label,\n  #cpms-role-management .crm-table th {\n    color: var(--crm-muted);\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n  }\n\n  #cpms-role-management .crm-summary-value {\n    margin-top: 4px;\n    font-size: 18px;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n\n  #cpms-role-management .crm-layout {\n    display: grid;\n    grid-template-columns: minmax(260px, 4fr) minmax(0, 8fr);\n    gap: 10px;\n  }\n\n  #cpms-role-management .crm-card {\n    min-width: 0;\n    overflow: hidden;\n  }\n\n  #cpms-role-management .crm-card-head {\n    min-height: 48px;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 10px 13px;\n    border-bottom: 1px solid var(--crm-line);\n  }\n\n  #cpms-role-management .crm-card-body {\n    padding: 12px 13px;\n  }\n\n  #cpms-role-management .crm-card-body--flush {\n    padding: 0;\n  }\n\n  #cpms-role-management .crm-form {\n    display: grid;\n    gap: 12px;\n  }\n\n  #cpms-role-management .crm-field {\n    display: grid;\n    gap: 5px;\n  }\n\n  #cpms-role-management .crm-input,\n  #cpms-role-management .crm-select {\n    width: 100%;\n    min-height: 34px;\n    padding: 6px 9px;\n    border: 1px solid var(--crm-border);\n    border-radius: 5px;\n    color: var(--crm-text);\n    background: var(--crm-panel);\n    font-family: inherit;\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-input:focus-visible,\n  #cpms-role-management .crm-select:focus-visible,\n  #cpms-role-management .crm-button:focus-visible,\n  #cpms-role-management .crm-switch:focus-visible {\n    outline: 2px solid #75aee8;\n    outline-offset: 2px;\n  }\n\n  #cpms-role-management .crm-actions {\n    justify-content: flex-end;\n    gap: 8px;\n  }\n\n  #cpms-role-management .crm-button {\n    min-height: 32px;\n    padding: 5px 11px;\n    border: 1px solid transparent;\n    border-radius: 5px;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 600;\n    cursor: pointer;\n  }\n\n  #cpms-role-management .crm-button--primary {\n    color: #ffffff;\n    background: var(--crm-blue);\n  }\n\n  #cpms-role-management .crm-button--secondary {\n    color: var(--crm-text);\n    border-color: var(--crm-border);\n    background: var(--crm-panel);\n  }\n\n  #cpms-role-management .crm-button:disabled,\n  #cpms-role-management .crm-input:disabled,\n  #cpms-role-management .crm-select:disabled,\n  #cpms-role-management .crm-switch:disabled {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n\n  #cpms-role-management .crm-toolbar {\n    display: grid;\n    grid-template-columns: minmax(180px, 320px) auto;\n    gap: 8px;\n  }\n\n  #cpms-role-management .crm-table-wrap {\n    overflow-x: auto;\n  }\n\n  #cpms-role-management .crm-table {\n    width: 100%;\n    min-width: 760px;\n    border-collapse: collapse;\n  }\n\n  #cpms-role-management .crm-table th,\n  #cpms-role-management .crm-table td {\n    padding: 9px 11px;\n    border-bottom: 1px solid var(--crm-line);\n    text-align: left;\n    vertical-align: middle;\n  }\n\n  #cpms-role-management .crm-table td {\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-table tbody tr:last-child td {\n    border-bottom: 0;\n  }\n\n  #cpms-role-management .crm-username {\n    font-weight: 700;\n  }\n\n  #cpms-role-management .crm-role-cell,\n  #cpms-role-management .crm-enabled-cell {\n    gap: 7px;\n  }\n\n  #cpms-role-management .crm-table .crm-select {\n    min-width: 125px;\n  }\n\n  #cpms-role-management .crm-badge {\n    min-height: 22px;\n    padding: 3px 7px;\n    border: 1px solid var(--crm-border);\n    border-radius: 999px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n  }\n\n  #cpms-role-management .crm-badge[data-tone='good'] {\n    color: var(--crm-green);\n    border-color: #b7dbc5;\n    background: var(--crm-green-soft);\n  }\n\n  #cpms-role-management .crm-badge[data-tone='warn'] {\n    color: var(--crm-amber);\n    border-color: #ead08c;\n    background: var(--crm-amber-soft);\n  }\n\n  #cpms-role-management .crm-badge[data-tone='bad'] {\n    color: var(--crm-red);\n    border-color: #efb8b8;\n    background: var(--crm-red-soft);\n  }\n\n  #cpms-role-management .crm-status {\n    min-height: 36px;\n    margin-top: 10px;\n    padding: 8px 10px;\n    border: 1px solid var(--crm-border);\n    border-radius: 5px;\n    color: var(--crm-muted);\n    background: var(--crm-panel);\n    font-size: 13px;\n  }\n\n  #cpms-role-management .crm-status[data-tone='good'] {\n    color: var(--crm-green);\n    border-color: #b7dbc5;\n    background: var(--crm-green-soft);\n  }\n\n  #cpms-role-management .crm-status[data-tone='bad'] {\n    color: var(--crm-red);\n    border-color: #efb8b8;\n    background: var(--crm-red-soft);\n  }\n\n  #cpms-role-management .crm-empty {\n    padding: 24px 13px;\n    text-align: center;\n  }\n\n  @media (max-width: 900px) {\n    #cpms-role-management .crm-layout {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  @media (max-width: 620px) {\n    #cpms-role-management {\n      padding: 9px;\n    }\n\n    #cpms-role-management .crm-header {\n      align-items: flex-start;\n      flex-direction: column;\n    }\n\n    #cpms-role-management .crm-header-meta {\n      justify-content: flex-start;\n    }\n\n    #cpms-role-management .crm-summary {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    #cpms-role-management .crm-toolbar {\n      grid-template-columns: 1fr;\n    }\n  }\n\u003c/style\u003e\n\n\u003csection id=\"cpms-role-management\" aria-labelledby=\"crm-title\"\u003e\n  \u003cheader class=\"crm-header\"\u003e\n    \u003cdiv\u003e\n      \u003ch1 id=\"crm-title\" class=\"crm-title\"\u003eCPMS Role Management\u003c/h1\u003e\n      \u003cdiv class=\"crm-subtitle\"\u003eAssign application permissions to authenticated Grafana users\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"crm-header-meta\"\u003e\n      \u003cspan id=\"crm-connection\" class=\"crm-chip\" role=\"status\" aria-live=\"polite\"\u003eLoading\u003c/span\u003e\n      \u003cspan id=\"crm-operator\" class=\"crm-chip\"\u003eAdministrator: —\u003c/span\u003e\n    \u003c/div\u003e\n  \u003c/header\u003e\n\n  \u003csection class=\"crm-summary\" aria-label=\"Role assignment summary\"\u003e\n    \u003cdiv class=\"crm-summary-card\"\u003e\u003cdiv class=\"crm-summary-label\"\u003eAssignments\u003c/div\u003e\u003cdiv id=\"crm-total\" class=\"crm-summary-value\"\u003e—\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"crm-summary-card\"\u003e\u003cdiv class=\"crm-summary-label\"\u003eEnabled\u003c/div\u003e\u003cdiv id=\"crm-enabled\" class=\"crm-summary-value\"\u003e—\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"crm-summary-card\"\u003e\u003cdiv class=\"crm-summary-label\"\u003eAdministrators\u003c/div\u003e\u003cdiv id=\"crm-admins\" class=\"crm-summary-value\"\u003e—\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"crm-summary-card\"\u003e\u003cdiv class=\"crm-summary-label\"\u003eDisabled\u003c/div\u003e\u003cdiv id=\"crm-disabled\" class=\"crm-summary-value\"\u003e—\u003c/div\u003e\u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003cdiv class=\"crm-layout\"\u003e\n    \u003csection class=\"crm-card\" aria-labelledby=\"crm-add-title\"\u003e\n      \u003cdiv class=\"crm-card-head\"\u003e\n        \u003cdiv\u003e\n          \u003ch2 id=\"crm-add-title\" class=\"crm-card-title\"\u003eAdd Assignment\u003c/h2\u003e\n          \u003cdiv class=\"crm-card-note\"\u003eUsername must match the Grafana login\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"crm-card-body\"\u003e\n        \u003cform id=\"crm-add-form\" class=\"crm-form\"\u003e\n          \u003clabel class=\"crm-field\"\u003e\n            \u003cspan class=\"crm-field-label\"\u003eGrafana Username\u003c/span\u003e\n            \u003cinput id=\"crm-new-username\" class=\"crm-input\" name=\"username\" type=\"text\" maxlength=\"255\" autocomplete=\"off\" required\u003e\n          \u003c/label\u003e\n          \u003clabel class=\"crm-field\"\u003e\n            \u003cspan class=\"crm-field-label\"\u003eCPMS Role\u003c/span\u003e\n            \u003cselect id=\"crm-new-role\" class=\"crm-select\" name=\"role\"\u003e\n              \u003coption value=\"OBSERVER\"\u003eObserver\u003c/option\u003e\n              \u003coption value=\"OPERATOR\"\u003eOperator\u003c/option\u003e\n              \u003coption value=\"SUPERVISOR\"\u003eSupervisor\u003c/option\u003e\n              \u003coption value=\"ADMIN\"\u003eAdministrator\u003c/option\u003e\n            \u003c/select\u003e\n          \u003c/label\u003e\n          \u003clabel class=\"crm-enabled-cell\"\u003e\n            \u003cinput id=\"crm-new-enabled\" class=\"crm-switch\" name=\"enabled\" type=\"checkbox\" checked\u003e\n            \u003cspan class=\"crm-help\"\u003eEnable this assignment immediately\u003c/span\u003e\n          \u003c/label\u003e\n          \u003cdiv class=\"crm-help\"\u003eUsers without an enabled assignment receive the default OBSERVER role. API-key identities remain SERVICE accounts and are not managed here.\u003c/div\u003e\n          \u003cdiv class=\"crm-actions\"\u003e\n            \u003cbutton id=\"crm-add-button\" class=\"crm-button crm-button--primary\" type=\"submit\"\u003eAdd Assignment\u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/form\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n    \u003csection class=\"crm-card\" aria-labelledby=\"crm-list-title\"\u003e\n      \u003cdiv class=\"crm-card-head\"\u003e\n        \u003cdiv\u003e\n          \u003ch2 id=\"crm-list-title\" class=\"crm-card-title\"\u003eUser Assignments\u003c/h2\u003e\n          \u003cdiv class=\"crm-card-note\"\u003eChanges take effect on the user’s next authorized request\u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"crm-toolbar\"\u003e\n          \u003cinput id=\"crm-search\" class=\"crm-input\" type=\"search\" placeholder=\"Search username\" aria-label=\"Search role assignments\"\u003e\n          \u003cbutton id=\"crm-refresh\" class=\"crm-button crm-button--secondary\" type=\"button\"\u003eRefresh\u003c/button\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"crm-card-body crm-card-body--flush crm-table-wrap\"\u003e\n        \u003ctable class=\"crm-table\"\u003e\n          \u003cthead\u003e\u003ctr\u003e\u003cth\u003eUser\u003c/th\u003e\u003cth\u003eRole\u003c/th\u003e\u003cth\u003eEnabled\u003c/th\u003e\u003cth\u003eUpdated\u003c/th\u003e\u003cth\u003eUpdated By\u003c/th\u003e\u003cth\u003eAction\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\n          \u003ctbody id=\"crm-rows\"\u003e\u003ctr\u003e\u003ctd colspan=\"6\"\u003e\u003cdiv class=\"crm-empty\"\u003eLoading role assignments…\u003c/div\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\n        \u003c/table\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n  \u003c/div\u003e\n\n  \u003cdiv id=\"crm-status\" class=\"crm-status\" role=\"status\" aria-live=\"polite\"\u003eLoading administrator identity and assignments…\u003c/div\u003e\n\u003c/section\u003e\n\n\u003cscript\u003e\n  (() =\u003e {\n    const root = document.getElementById('cpms-role-management');\n    if (!root) return;\n    if (typeof root.__crmCleanup === 'function') root.__crmCleanup();\n\n    const API = '/cpms/auth';\n    const REQUEST_TIMEOUT_MS = 10000;\n    const roles = ['OBSERVER', 'OPERATOR', 'SUPERVISOR', 'ADMIN'];\n    const state = { identity: null, users: [], busy: false };\n    const controllers = new Set();\n    const $ = (selector) =\u003e root.querySelector(selector);\n\n    function setText(selector, value) {\n      const target = $(selector);\n      if (target) target.textContent = value;\n    }\n\n    function setStatus(message, tone) {\n      const target = $('#crm-status');\n      target.textContent = message;\n      target.dataset.tone = tone || '';\n    }\n\n    async function request(path, options) {\n      const controller = new AbortController();\n      const timeout = setTimeout(() =\u003e controller.abort(), REQUEST_TIMEOUT_MS);\n      controllers.add(controller);\n      try {\n        const response = await fetch(API + path, {\n          credentials: 'same-origin',\n          ...options,\n          headers: { 'Content-Type': 'application/json', ...(options \u0026\u0026 options.headers) },\n          signal: controller.signal,\n        });\n        const contentType = response.headers.get('content-type') || '';\n        const body = contentType.includes('application/json') ? await response.json() : null;\n        if (!response.ok) throw new Error((body \u0026\u0026 body.error) || `Request failed (${response.status})`);\n        return body;\n      } finally {\n        clearTimeout(timeout);\n        controllers.delete(controller);\n      }\n    }\n\n    function formatTime(value) {\n      const date = new Date(value);\n      if (!value || Number.isNaN(date.getTime())) return '—';\n      return new Intl.DateTimeFormat('en-GB', {\n        timeZone: 'Asia/Kuala_Lumpur',\n        day: '2-digit',\n        month: '2-digit',\n        year: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit',\n        hour12: false,\n      }).format(date);\n    }\n\n    function cell(text, className) {\n      const target = document.createElement('td');\n      target.textContent = text;\n      if (className) target.className = className;\n      return target;\n    }\n\n    function badge(text, tone) {\n      const target = document.createElement('span');\n      target.className = 'crm-badge';\n      target.dataset.tone = tone;\n      target.textContent = text;\n      return target;\n    }\n\n    function roleSelect(value) {\n      const select = document.createElement('select');\n      select.className = 'crm-select';\n      select.setAttribute('aria-label', 'CPMS role');\n      roles.forEach((role) =\u003e {\n        const option = document.createElement('option');\n        option.value = role;\n        option.textContent = role === 'ADMIN' ? 'Administrator' : role.charAt(0) + role.slice(1).toLowerCase();\n        option.selected = role === value;\n        select.appendChild(option);\n      });\n      return select;\n    }\n\n    function renderSummary() {\n      const enabled = state.users.filter((user) =\u003e user.enabled).length;\n      setText('#crm-total', String(state.users.length));\n      setText('#crm-enabled', String(enabled));\n      setText('#crm-admins', String(state.users.filter((user) =\u003e user.enabled \u0026\u0026 user.role === 'ADMIN').length));\n      setText('#crm-disabled', String(state.users.length - enabled));\n    }\n\n    function renderRows() {\n      const body = $('#crm-rows');\n      const filter = $('#crm-search').value.trim().toLowerCase();\n      const users = state.users.filter((user) =\u003e user.username.toLowerCase().includes(filter));\n      body.replaceChildren();\n\n      if (!users.length) {\n        const row = document.createElement('tr');\n        const target = cell(filter ? 'No matching assignments.' : 'No role assignments configured.');\n        target.colSpan = 6;\n        target.className = 'crm-empty';\n        row.appendChild(target);\n        body.appendChild(row);\n        return;\n      }\n\n      users.forEach((user) =\u003e {\n        const row = document.createElement('tr');\n        const username = cell(user.username, 'crm-username');\n        const roleCell = document.createElement('td');\n        const select = roleSelect(user.role);\n        roleCell.appendChild(select);\n\n        const enabledCell = document.createElement('td');\n        enabledCell.className = 'crm-enabled-cell';\n        const enabled = document.createElement('input');\n        enabled.className = 'crm-switch';\n        enabled.type = 'checkbox';\n        enabled.checked = Boolean(user.enabled);\n        enabled.setAttribute('aria-label', `Enable ${user.username}`);\n        const enabledBadge = badge(user.enabled ? 'Enabled' : 'Disabled', user.enabled ? 'good' : 'bad');\n        enabledCell.append(enabled, enabledBadge);\n\n        const actionCell = document.createElement('td');\n        const save = document.createElement('button');\n        save.className = 'crm-button crm-button--primary';\n        save.type = 'button';\n        save.textContent = 'Save';\n        save.disabled = true;\n        actionCell.appendChild(save);\n\n        const refreshDirty = () =\u003e {\n          const dirty = select.value !== user.role || enabled.checked !== Boolean(user.enabled);\n          enabledBadge.textContent = enabled.checked ? 'Enabled' : 'Disabled';\n          enabledBadge.dataset.tone = enabled.checked ? 'good' : 'bad';\n          save.disabled = !dirty || state.busy;\n        };\n        select.addEventListener('change', refreshDirty);\n        enabled.addEventListener('change', refreshDirty);\n        save.addEventListener('click', () =\u003e saveUser(user, select.value, enabled.checked));\n\n        row.append(username, roleCell, enabledCell, cell(formatTime(user.updatedAt)), cell(user.updatedBy || '—'), actionCell);\n        body.appendChild(row);\n      });\n    }\n\n    function render() {\n      renderSummary();\n      renderRows();\n      setText('#crm-operator', `Administrator: ${state.identity ? state.identity.username : '—'}`);\n      setText('#crm-connection', state.identity ? 'Connected' : 'Unavailable');\n      const disabled = state.busy || !state.identity;\n      $('#crm-add-button').disabled = disabled;\n      $('#crm-refresh').disabled = state.busy;\n    }\n\n    async function load() {\n      if (state.busy) return;\n      state.busy = true;\n      render();\n      setStatus('Loading role assignments…');\n      try {\n        const [identity, result] = await Promise.all([request('/me'), request('/roles')]);\n        state.identity = identity;\n        state.users = Array.isArray(result.users) ? result.users : [];\n        setStatus(`Loaded ${state.users.length} role assignments.`, 'good');\n      } catch (error) {\n        state.identity = null;\n        state.users = [];\n        setStatus(error.name === 'AbortError' ? 'Request timed out.' : error.message, 'bad');\n      } finally {\n        state.busy = false;\n        render();\n      }\n    }\n\n    async function saveAssignment(payload, successMessage) {\n      if (state.busy) return;\n      state.busy = true;\n      render();\n      setStatus(`Saving ${payload.username}…`);\n      try {\n        const result = await request('/roles/save', { method: 'POST', body: JSON.stringify(payload) });\n        const index = state.users.findIndex((user) =\u003e user.username.toLowerCase() === result.user.username.toLowerCase());\n        if (index \u003e= 0) state.users[index] = result.user;\n        else state.users.push(result.user);\n        setStatus(successMessage, 'good');\n        return true;\n      } catch (error) {\n        setStatus(error.name === 'AbortError' ? 'Request timed out.' : error.message, 'bad');\n        return false;\n      } finally {\n        state.busy = false;\n        render();\n      }\n    }\n\n    async function saveUser(user, role, enabled) {\n      const sensitive = (user.role === 'ADMIN' \u0026\u0026 role !== 'ADMIN') || (user.enabled \u0026\u0026 !enabled);\n      if (sensitive \u0026\u0026 !confirm(`Confirm the role or enabled-state change for ${user.username}?`)) return;\n      await saveAssignment({ username: user.username, role, enabled }, `Updated ${user.username}.`);\n    }\n\n    $('#crm-add-form').addEventListener('submit', async (event) =\u003e {\n      event.preventDefault();\n      const username = $('#crm-new-username').value.trim();\n      if (!username) return setStatus('Grafana username is required.', 'bad');\n      const saved = await saveAssignment(\n        { username, role: $('#crm-new-role').value, enabled: $('#crm-new-enabled').checked },\n        `Added ${username}.`\n      );\n      if (saved) {\n        $('#crm-add-form').reset();\n        $('#crm-new-enabled').checked = true;\n      }\n    });\n    $('#crm-search').addEventListener('input', renderRows);\n    $('#crm-refresh').addEventListener('click', load);\n\n    const observer = new MutationObserver(() =\u003e {\n      if (!root.isConnected) root.__crmCleanup();\n    });\n    if (root.parentNode) observer.observe(root.parentNode, { childList: true });\n    root.__crmCleanup = () =\u003e {\n      observer.disconnect();\n      controllers.forEach((controller) =\u003e controller.abort());\n      controllers.clear();\n      root.__crmCleanup = null;\n    };\n\n    load();\n  })();\n\u003c/script\u003e\n",
